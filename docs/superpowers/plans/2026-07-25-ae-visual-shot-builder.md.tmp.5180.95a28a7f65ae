  const r = C.checkEs3('const x = () => 1;');
  assert.equal(r.ok, false);
  assert.match(r.reason, /const|arrow/i);
  assert.equal(C.checkEs3('var x = 1;').ok, true);
});

test('the entry function name is discovered, not assumed', () => {
  assert.equal(C.entryFunction('function ef_gen_shot_01(comp, spec){}'), 'ef_gen_shot_01');
  assert.equal(C.entryFunction('var q = 1;'), null);
});
