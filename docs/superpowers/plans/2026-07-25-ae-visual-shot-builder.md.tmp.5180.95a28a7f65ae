test('a verdict of "fix" carries a patch; "ok" ends the loop', () => {
  assert.equal(H.parseVerdict('{"verdict":"ok"}').done, true);
  const f = H.parseVerdict('{"verdict":"fix","patch":{"variant":"slide_left"},"why":"stagger unclear"}');
