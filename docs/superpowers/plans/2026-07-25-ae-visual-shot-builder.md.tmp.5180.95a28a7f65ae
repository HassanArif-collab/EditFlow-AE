  const out = C.extractCode('Here you go:\n```javascript\nfunction ef_gen_a(c,s){}\n```\nHope that helps!');
  assert.equal(out.trim(), 'function ef_gen_a(c,s){}');
});

test('a bare reply with no fence still yields the code', () => {
